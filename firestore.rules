rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (UID from Auth)
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string
    //   - photoURL: string
    //   - role: string (user/admin)
    //   - createdAt: timestamp
    //
    // Collection: helpers
    // Document ID: auto-generated
    // Fields:
    //   - name: string
    //   - category: string
    //   - rating: number
    //   - reviewCount: number
    //   - imageUrl: string
    //   - description: string
    //   - priceRange: string
    //   - skills: list
    //   - shopName: string
    //   - shopAddress: string
    //   - location: map {lat: number, lng: number}
    //
    // ===============================================================

    // Collection: helpers/{helperId}/invoices
    // Document ID: auto-generated
    // Fields:
    //   - bookingId: string (required)
    //   - userId: string (required)
    //   - helperId: string (required)
    //   - amount: string (required)
    //   - status: string (required)
    //   - date: string
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // Collection: bookings
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - helperId: string (required)
    //   - status: string (required)
    //   - createdAt: timestamp (required)
    //   - helperName: string
    //   - category: string
    //   - price: string
    //   - date: string
    //   - time: string
    //   - address: string
    //   - paymentStatus: string
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "ishansrivastavaaa@gmail.com");
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string &&
             (!('role' in data) || data.role in ['user', 'admin']);
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'helperId', 'status', 'createdAt']) &&
             data.userId is string &&
             data.helperId is string &&
             data.status in ['Upcoming', 'Completed', 'Cancelled'] &&
             data.createdAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['bookingId', 'userId', 'helperId', 'amount', 'status', 'createdAt']) &&
             data.bookingId is string &&
             data.userId is string &&
             data.helperId is string &&
             data.amount is string &&
             data.status in ['Pending', 'Paid'] &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == 'user';
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role;
    }

    match /helpers/{helperId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin();
      
      match /invoices/{invoiceId} {
        allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId && isValidInvoice(request.resource.data);
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && isValidInvoice(request.resource.data) && request.resource.data.userId == resource.data.userId;
        allow delete: if isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId && isValidBooking(request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && isValidBooking(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }
  }
}
